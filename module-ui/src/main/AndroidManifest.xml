<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The optional liquid pipeline is instantiated only on API 33+. Android 8–12
         retains the Haze/standard navigation path and never creates blur objects. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.tim" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.smile.gifmaker" />
    </queries>
    <application>
        <activity android:name="com.handoff.ui.DashboardActivity" android:exported="true" android:theme="@style/HandoffTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
